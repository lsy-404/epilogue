{
  "name": "epilogue",
  "productName": "Epilogue",
  "version": "0.5.4",
  "packageManager": "pnpm@10.34.6",
  "description": "Epilogue — AI file workflow: understand, organize and recall your files.",
  "main": "src/main/index.js",
