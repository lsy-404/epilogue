    "@model-auth/providers": "https://github.com/lsy-404/platform-kit/releases/download/model-auth-providers-v0.13.0/model-auth-providers-0.13.0.tgz",
    "@model-auth/vue": "https://github.com/lsy-404/platform-kit/releases/download/model-auth-vue-v0.10.3/model-auth-vue-0.10.3.tgz",
    "adm-zip": "^0.6.0",
    "ai": "^6.0.271",
